# 复制本文件为 .env 后再填写；.env 已被 .gitignore 忽略
# 不要把真实 Key 写进本文件或聊天窗口
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本地代理
AI_PORT=8126
AI_HOST=127.0.0.1
AI_ALLOWED_ORIGINS=http://127.0.0.1:8125,http://localhost:8125,https://cshop-store-60211.app.workbuddy.host

# 没有 Key 时可用本地脚本回复做界面联调（生产环境不要开启）
# AI_MOCK=1
